{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--prefix", "frontend"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--project", "backend", "uvicorn", "main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000,
      "autoPort": false
    }
  ]
}
